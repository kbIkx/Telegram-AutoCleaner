[Unit]
Description=Telegram AutoCleaner Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=autocleaner
Group=autocleaner
WorkingDirectory=/opt/autocleaner
ExecStart=/opt/autocleaner/.venv/bin/python /opt/autocleaner/run.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/autocleaner/data /opt/autocleaner/logs

[Install]
WantedBy=multi-user.target
